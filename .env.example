# Optional: enables accounts, cloud sync and the leaderboard.
# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). Leave them empty to run in guest mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Google / GitHub sign-in: the OAuth client ID and secret are entered ONLY in the
# Supabase dashboard (Authentication -> Providers). Never put them in this file or in code.
